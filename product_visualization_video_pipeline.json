    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "// Guards the FAL polling loop: the original loop could spin forever if the job never completed.\nconst cfg = $('Config').first().json;\nconst attempt = $runIndex + 1;\nconst status = String($json.status || '').toUpperCase();\n\nif (['FAILED', 'ERROR', 'CANCELLED', 'CANCELED'].includes(status)) {\n  throw new Error(`FAL job ended with status ${status}`);\n}\nif (status !== 'COMPLETED' && attempt >= Number(cfg.poll_max_attempts)) {\n  throw new Error(`FAL job not completed after ${attempt} status checks (last status: ${status || 'unknown'})`);\n}\nreturn { json: { ...$json, poll_attempt: attempt } };"
      },
      "id": "7d1ffe58-f467-52fc-884f-3c89c943748e",
      "name": "Poll Guard",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        212,
        544
      ],
      "notes": "Stops the loop on FAILED/ERROR or after poll_max_attempts checks. The error goes to the Error Trigger.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Output quality gate: is the downloaded file really a video of a sane size?\nconst cfg = $('Config').first().json;\nconst item = $input.first();\nconst keys = Object.keys(item.binary || {});\nif (!keys.length) throw new Error('Quality check failed: the download returned no file');\n\nconst key = item.binary.data ? 'data' : keys[0];\nconst mime = String(item.binary[key].mimeType || '');\nif (!mime.startsWith('video/')) {\n  throw new Error(`Quality check failed: expected a video file, got \"${mime || 'unknown type'}\"`);\n}\n\nconst buf = await this.helpers.getBinaryDataBuffer(0, key);\nconst min = Number(cfg.min_video_bytes);\nconst max = Number(cfg.max_video_bytes);\nif (buf.length < min) throw new Error(`Quality check failed: video is too small (${buf.length} < ${min} bytes)`);\nif (buf.length > max) throw new Error(`Quality check failed: video is too large (${buf.length} > ${max} bytes)`);\n\nlet videoUrl = '';\ntry { videoUrl = $('FAL WAN i2v (Result)').first().json.video.url || ''; } catch (e) { videoUrl = ''; }\n\nreturn [{ json: { ...item.json, video_url: videoUrl, video_bytes: buf.length, video_mime: mime }, binary: item.binary }];"
      },
      "id": "bc40b0d7-a47b-51bc-af0e-a8b12c92c3d0",
      "name": "Video Quality Check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1080,
        528
      ]
