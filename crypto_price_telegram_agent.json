    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.message.text }}",
        "options": {
          "systemMessage": "You are a crypto price assistant in a Telegram chat. For ANY question about a cryptocurrency price you MUST call the CoinMarketCap Price tool with the ticker symbol (for example BTC, ETH) and answer using only the tool result. Reply in the user's language in 1-3 short lines, with prices in USD. Never guess or recall prices from memory. If the symbol is unknown or the tool fails, say that you could not fetch the price. For unrelated questions, say that you only answer cryptocurrency price questions.",
          "returnIntermediateSteps": true
        }
      },
      "id": "e624ae6a-6d22-4f53-9848-cf6427cdd521",
      "name": "CoinMarketCap Price Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        860,
        80
      ],
      "typeVersion": 1.7,
      "notes": "Error output (2nd) goes to the fallback reply instead of leaving the user without an answer. Retry re-runs the whole agent.",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000,
      "onError": "continueErrorOutput",
      "notesInFlow": true
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "b5c25cd4-226b-4778-863f-79b13b4a5202",
