    {
      "parameters": {
        "toolDescription": "The tool going to recieve input of cryptocurrency name and then request the price from CoinMarketCap and send the price back in a message.",
        "url": "https://pro-api.coinmarketcap.com/v1/cryptocurrency/quotes/latest",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "parametersQuery": {
          "values": [
            {
              "name": "symbol"
            },
            {
              "name": "convert",
              "valueProvider": "fieldValue",
              "value": "USD"
            }
          ]
        },
        "sendHeaders": true,
        "parametersHeaders": {
          "values": [
            {
              "name": "Accept",
              "valueProvider": "fieldValue",
              "value": "application/json"
            }
          ]
        }
      },
      "id": "ea4ab58f-55c6-4952-bcb0-127994aadfad",
      "name": "CoinMarketCap Price",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "position": [
        1080,
        400
      ],
      "typeVersion": 1.1
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "7da301cb-4487-528d-8989-899ce8e9bb27",
              "name": "telegram_chat_id",
              "value": "REPLACE_WITH_ADMIN_TELEGRAM_CHAT_ID",
              "type": "string"
            },
            {
              "id": "cd1a67f4-c426-5d87-ba6d-3da0e7f3ecf7",
              "name": "sheet_document_id",
              "value": "REPLACE_WITH_GOOGLE_SHEET_ID",
              "type": "string"
            },
            {
              "id": "19820dcb-e69a-55cb-81f4-81b339315f3b",
              "name": "sheet_tab_name",
              "value": "Run Log",
              "type": "string"
            },
            {
              "id": "9747b9d8-af84-5dce-a646-5677849bbff9",
              "name": "fallback_message",
              "value": "Sorry, I couldn't get a reliable price right now. Please try again in a minute.",
              "type": "string"
            },
            {
              "id": "c4d50a19-937d-50df-900d-9a3793f19364",
              "name": "require_tool_call_for_prices",
              "value": "true",
              "type": "string"
            },
            {
              "id": "a72c9856-cded-596f-b0bb-ffcb1773a928",
              "name": "max_reply_chars",
              "value": 3800,
              "type": "number"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "a7878938-ddd0-5257-80d3-7c362fc2f2aa",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        140,
        80
      ],
      "notes": "Settings in one place. telegram_chat_id is the ADMIN chat for alerts, not the end user.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Answer guard: a price in the reply must be backed by a successful CoinMarketCap tool call.\nconst cfg = $('Config').first().json;\nconst out = $input.first().json;\nconst text = String(out.output || '').trim();\nconst steps = Array.isArray(out.intermediateSteps) ? out.intermediateSteps : [];\n\nconst toolSteps = steps.filter((s) => /coinmarketcap/i.test(String((s && s.action && s.action.tool) || '')));\nconst toolOk = toolSteps.some((s) => {\n  const obs = typeof s.observation === 'string' ? s.observation : JSON.stringify(s.observation || '');\n  return obs.length > 0 && !/\"error_code\"\\s*:\\s*[1-9]/.test(obs) && !/^error/i.test(obs.trim());\n});\n\nconst requireTool = String(cfg.require_tool_call_for_prices).toLowerCase() === 'true';\nconst looksLikePrice = /\\d/.test(text);\n\nlet ok = true;\nlet reason = '';\nif (!text) { ok = false; reason = 'empty_answer'; }\nelse if (requireTool && looksLikePrice && !toolOk) { ok = false; reason = 'price_without_successful_tool_call'; }\n\nconst max = Number(cfg.max_reply_chars);\nlet reply = text.length > max ? text.slice(0, max - 1) + '…' : text;\nif (ok && toolOk) reply += `\\n\\nSource: CoinMarketCap, ${new Date().toISOString().slice(0, 16).replace('T', ' ')} UTC`;\n\nreturn [{ json: { ok, reason, reply_text: reply, tool_called: toolSteps.length > 0, tool_ok: toolOk } }];"
      },
      "id": "0a55dffb-9446-577e-a228-d0a1c44e4dc4",
      "name": "Validate Answer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        80
      ],
      "notes": "Blocks price answers that were not backed by a successful tool call (anti-hallucination).",
      "notesInFlow": true
    },
    {
